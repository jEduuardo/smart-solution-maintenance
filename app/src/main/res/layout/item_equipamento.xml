<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/branco">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_equipment" app:tint="@color/primary"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/card_consumo_bg" android:padding="11dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvNome" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Nome" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/preto"/>
                <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Ativo"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="@color/verde"/>
            </LinearLayout>
            <TextView android:id="@+id/tvCategoria" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Categoria"
                android:textSize="11sp" android:textColor="@color/primary"
                android:background="@color/card_consumo_bg" android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" android:layout_marginTop="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/tvSetor" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Setor" android:textSize="11sp" android:textColor="@color/cinza"/>
                <TextView android:id="@+id/tvModelo" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Modelo"
                    android:textSize="11sp" android:textColor="@color/cinza"/>
            </LinearLayout>
            <TextView android:id="@+id/tvUltimaManutencao" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Última manutenção: --"
                android:textSize="10sp" android:textColor="@color/primary"
                android:layout_marginTop="3dp" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
