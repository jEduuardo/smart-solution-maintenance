<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/branco">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">

        <View android:id="@+id/containerTipo" android:layout_width="5dp"
            android:layout_height="match_parent" android:background="@color/primary"
            android:layout_marginEnd="12dp"/>

        <ImageView android:id="@+id/ivIcone" android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_water" android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/card_consumo_bg" android:padding="10dp"
            android:layout_marginEnd="12dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvTipo" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Água" android:textSize="11sp"
                    android:textStyle="bold" android:textColor="@color/primary"
                    android:background="@color/card_consumo_bg" android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
                <TextView android:id="@+id/tvSetor" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Setor" android:textSize="11sp" android:textColor="@color/cinza"
                    android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/tvValor" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0.00 m³"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/preto"
                android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/tvObservacao" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/cinza" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>

        <TextView android:id="@+id/tvData" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="00/00/0000"
            android:textSize="10sp" android:textColor="@color/cinza" android:layout_marginStart="6dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
